{
  "name": "astra",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "setup:grammars": "npx tree-sitter build --wasm node_modules/tree-sitter-javascript -o grammars/tree-sitter-javascript.wasm && npx tree-sitter build --wasm node_modules/tree-sitter-typescript/typescript -o grammars/tree-sitter-typescript.wasm && npx tree-sitter build --wasm node_modules/tree-sitter-python -o grammars/tree-sitter-python.wasm",
    "verify": "npx tsx scripts/verify-env.ts",
    "verify:ingestion": "npx tsx scripts/verify-ingestion.ts",
    "verify:retrieval": "npx tsx scripts/verify-retrieval.ts",
    "verify:generation": "npx tsx scripts/verify-generation.ts",
    "setup": "npm run setup:grammars && npm run verify"
  },
  "dependencies": {
    "@chroma-core/default-embed": "^0.1.9",
    "@xenova/transformers": "^2.17.2",
    "chromadb": "^3.5.0",
    "groq-sdk": "^1.5.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "simple-git": "^3.36.0",
    "web-tree-sitter": "^0.26.11",
    "wink-bm25-text-search": "^3.1.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "tree-sitter-cli": "^0.26.11",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-typescript": "^0.23.2",
    "tsx": "^4.23.5",
    "typescript": "^5"
  }
}
