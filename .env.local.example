# ============================================================
# ASTra — Environment Variables
# ============================================================
# Copy this file to .env.local:   cp .env.local.example .env.local
# Then fill in your keys. .env.local is gitignored.
# ============================================================

# ===== Embedding Engine Provider =====
# Options: "local"  — 100% Free, Unlimited ONNX model (Xenova/all-MiniLM-L6-v2), recommended for 1000+ chunks
#          "gemini" — Google Gemini Cloud API (gemini-embedding-001)
EMBEDDING_PROVIDER=local

# ===== Google Gemini Embedding API (Required only if EMBEDDING_PROVIDER=gemini) =====
# 100% Free at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# ===== Groq LLM Inference (Required for Q&A) =====
# 100% Free at https://console.groq.com/
# Used for grounded code answers
GROQ_API_KEY=your_groq_api_key_here

# ===== Optional Overrides =====
# EMBEDDING_MODEL=gemini-embedding-001
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
# CHROMA_URL=http://localhost:8000


