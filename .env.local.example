# ============================================================
# Ask My Codebase — Environment Variables
# ============================================================
# Copy this file to .env.local:   cp .env.local.example .env.local
# Then fill in your keys. .env.local is gitignored.
# ============================================================

# ===== LLM Generation =====
# Groq API (free tier, Llama 3.3 70B) — get key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ===== Vector Store (Supabase — production/demo) =====
# Supabase pgvector — get at https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ===== Vector Store (ChromaDB — local dev) =====
# Default: http://localhost:8000 (run `chroma run` or `docker run chromadb/chroma`)
CHROMA_URL=http://localhost:8000

# ===== Embedding Model =====
# Model ID for @xenova/transformers (change to swap models)
# Default produces 384-dimensional vectors
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
